<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BankOfAmerica Smoke Tests" verbose="1" parallel="none">

    <test name="Smoke Tests">
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.bankofamerica.tests.LoginPositiveTests"/>
            <class name="com.bankofamerica.tests.LoginNegativeTests"/>
            <class name="com.bankofamerica.tests.LoginSecurityTests"/>
        </classes>
    </test>

</suite>
